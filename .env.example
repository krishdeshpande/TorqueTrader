# ─────────────────────────────────────────────────────────────────────────────
# TorqueTrader — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Local dev (SQLite):
DATABASE_URL=sqlite:///./torque_trader.db
# Production (existing Supabase PostgreSQL connection string):
# DATABASE_URL=postgresql://user:password@host:5432/torquetrader

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_64_byte_random_string

# ── Gemini Automotive AI Advisor & Chatbot ───────────────────────────────────
# Free API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Powers the interactive Auto Advisory questionnaire & multi-turn chat
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave blank to use in-memory fakeredis (dev only — state lost on restart).
# Upstash free tier: https://upstash.com
# REDIS_URL=redis://:password@host.upstash.io:6379

# ── Email OTP & Consultation Alerts (Resend) ───────────────────────────────────
# Free tier: 3,000 emails/month. Sign up at https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OTP_FROM_EMAIL=noreply@yourdomain.com
# FOUNDER_EMAIL=krishdeshpande16@gmail.com

# ── Cloudflare R2 (File Storage) ─────────────────────────────────────────────
# Free tier: 10 GB storage, 1M reads/month.
# Get credentials at: https://dash.cloudflare.com → R2 → Manage API Tokens
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_PUBLIC_BUCKET=torquetrader-public
# R2_PRIVATE_BUCKET=torquetrader-private

# ── Live mParivahan / VAHAN RC API Provider ──────────────────────────────────
# VAHAN_API_KEY=your_vahan_api_key
# VAHAN_API_PROVIDER=surepass

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for dev only.
ALLOWED_ORIGINS=*
